{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dawah",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  // Demo data: one row holding the whole dataset. Wrangler creates the database on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dawah-demo"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
