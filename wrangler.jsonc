{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dawah",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  // Demo data: one row holding the whole dataset. Wrangler creates the database on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dawah-demo"
    }
  ],
  // Branch previews (PR builds) use their own demo database so they never touch the main site's data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "dawah-demo-preview",
        "database_id": "e182c2c7-7a88-4e3e-a63a-15b82373a506"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
